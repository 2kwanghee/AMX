#!/bin/sh
# amx-claude — launch Claude Code (the runner) under the AMX deliver lock (B1b).
#
# Why: when AMA delivers a new account it briefly stages that account's
# credential into the shared Claude config home and, for a sub-second window,
# makes it the live account before restoring the previously-active one (see
# AMA handleDeliver / SSOT §6.3). A `claude` process that STARTS UP inside that
# window would read the new account's `.credentials.json` and bill it by
# mistake. B1a narrows the window to milliseconds; this wrapper closes it for
# runners launched through it.
#
# How: AMA holds an EXCLUSIVE flock on `<CLAUDE_CONFIG_DIR>/.amx-deliver.lock`
# for the whole swap. This wrapper takes a SHARED flock on the same file, waits
# (bounded) for any in-progress deliver to finish, then RELEASES it and starts
# claude. We do NOT hold the lock for claude's lifetime: that would make AMA's
# exclusive deliver wait for the runner to exit (a long interactive session could
# stall deliver, and thus the whole switching engine, for hours). The lock is
# separate from the credential files, so claude never touches it.
#
# Best-effort, not a hard guarantee: after releasing the lock there is a tiny gap
# before claude reads the credential. B1a (previous-active restore + atomic write)
# is the PRIMARY defense that bounds that gap to a sub-second, torn-free window;
# this wrapper is the secondary "do not start on top of an in-progress deliver"
# guard. Perfect hand-off would require claude to expose its credential-read
# instant, which it does not. See docs/DEPLOYMENT-RUNNER.md.
#
# Usage: drop-in replacement for `claude`. All arguments — including `-p
# <command>` used by the ClickEye webhook path — are passed through unchanged.
#   amx-claude                 # interactive, same as `claude`
#   amx-claude -p "do a thing"  # batch, same as `claude -p ...`
# Recommended install: alias claude=amx-claude for interactive shells, and call
# amx-claude at the ClickEye webhook entrypoint. See docs/DEPLOYMENT-RUNNER.md.

set -eu

# The runner and AMA MUST agree on the config home. Default to Claude's own
# default (~/.claude) when CLAUDE_CONFIG_DIR is unset, so the lock path matches
# the credential path claude will actually read.
#
# FIXED ANCHOR, P3 invariant (design note P3, resolving P2 review item ③):
# CONFIG_DIR/LOCK_FILE below are captured from CLAUDE_CONFIG_DIR EXACTLY AS
# GIVEN, before the active-profile block further down ever touches that
# variable. AMA's own deliver lock (internal/tsamx/exec.go's lockConfigHome)
# resolves the SAME formula — the daemon's own ConfigDir, else the driver's
# DefaultConfigHome — and that side never consults an active profile pointer
# either, so the two sides only stay pointed at the same file as long as
# NEITHER side lets a per-profile override leak into this computation. Do not
# move this below the profile block, and do not reassign CONFIG_DIR/LOCK_FILE
# anywhere else in this file.
CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
LOCK_FILE="$CONFIG_DIR/.amx-deliver.lock"

# Locate the real claude (never recurse into this wrapper if it shadows claude
# on PATH under the same name).
CLAUDE_BIN="${AMX_CLAUDE_BIN:-claude}"

# If flock(1) or the config dir is unavailable, fall back to launching claude
# directly rather than blocking the runner. B1a still bounds the exposure to the
# sub-second swap window; the flock is defense-in-depth on top of that.
if ! command -v flock >/dev/null 2>&1; then
	exec "$CLAUDE_BIN" "$@"
fi
if ! mkdir -p "$CONFIG_DIR" 2>/dev/null; then
	exec "$CLAUDE_BIN" "$@"
fi

# Wait (bounded) for any in-progress deliver to release the exclusive lock, then
# drop our shared lock immediately and start claude. `-w` bounds the wait; if it
# times out (deliver still running) we start anyway — best-effort, B1a bounds the
# residual exposure. `-c true` acquires+releases without holding across claude.
# AMX_DELIVER_WAIT overrides the wait bound (seconds; default 5).
flock -w "${AMX_DELIVER_WAIT:-5}" -s "$LOCK_FILE" -c true 2>/dev/null || true

# --- Active profile pointer (P3, optional) -----------------------------------
# internal/seat/profile (P2) + internal/seat.Switcher (P3) can stage a Claude
# account into its own config-home directory
# ($AMX_STATE_DIR/profiles/claude/<accountKey>/) instead of the shared
# CONFIG_DIR above. Neither is wired to anything yet as of this commit — no
# caller ever writes the active pointer file — so this block is always a
# no-op today; it exists so the wrapper is ready the day something does.
#
# Only CLAUDE_CONFIG_DIR for THIS claude invocation is touched here.
# CONFIG_DIR/LOCK_FILE, fixed above, are NEVER reassigned by this block — see
# the "FIXED ANCHOR" comment above for why that separation must hold.
#
# Fail-open at every step: an unset AMX_STATE_DIR, a missing/unreadable
# pointer file, a pointer that is not shaped like a real accountKey (64
# lowercase hex chars), or a profile directory that does not exist (or is a
# symlink) all leave CLAUDE_CONFIG_DIR exactly as the caller set it — this
# must never be what stops a runner from starting.
AMX_ACTIVE_PROFILE_DIR=""
if [ -n "${AMX_STATE_DIR:-}" ]; then
	_amx_active_file="$AMX_STATE_DIR/profiles/claude/active"
	if [ -f "$_amx_active_file" ] && [ -r "$_amx_active_file" ]; then
		_amx_active_key=$(cat "$_amx_active_file" 2>/dev/null || true)
		case "$_amx_active_key" in
		"" | *[!0-9a-f]* )
			: # empty, or contains a character outside [0-9a-f]: not a real accountKey
			;;
		* )
			if [ "${#_amx_active_key}" -eq 64 ]; then
				_amx_profile_dir="$AMX_STATE_DIR/profiles/claude/$_amx_active_key"
				if [ -d "$_amx_profile_dir" ] && [ ! -L "$_amx_profile_dir" ]; then
					AMX_ACTIVE_PROFILE_DIR="$_amx_profile_dir"
					CLAUDE_CONFIG_DIR="$_amx_profile_dir"
					export CLAUDE_CONFIG_DIR
				fi
				unset _amx_profile_dir
			fi
			;;
		esac
		unset _amx_active_key
	fi
	unset _amx_active_file
fi
# -----------------------------------------------------------------------------

# --- Langfuse tracing (P3, optional) -----------------------------------------
# If (and only if) `<CLAUDE_CONFIG_DIR>/amx-langfuse.env` exists, load it and,
# when it opts in with TRACE_TO_LANGFUSE=true, export the credentials so the
# Stop hook (installed in settings.json) ships this session to Langfuse. A
# session NOT launched through this wrapper never gets the keys in its env, so
# the hook no-ops there — only wrapper-launched sessions are traced.
#
# Fail-open, always: a missing file, a missing tsamx/timeout, or a tsamx query
# error must never stop claude from starting (same philosophy as the flock
# above). The env file is TRUSTED input — it is created 0600 by
# install-langfuse-hook.sh, not user-authored — so we do not defend against
# hostile content; we only guard against an accidentally malformed file by
# pre-validating its syntax (`sh -n`) and skipping the load on a parse error,
# rather than letting `set -e` abort the runner. The whole block runs `set +e`.
LF_ENV_FILE="$CONFIG_DIR/amx-langfuse.env"
if [ -f "$LF_ENV_FILE" ] && [ -r "$LF_ENV_FILE" ]; then
	set +e
	# Only source if it parses cleanly, so a hand-edited broken file can never
	# abort the runner.
	if sh -n "$LF_ENV_FILE" 2>/dev/null; then
		# shellcheck disable=SC1090
		. "$LF_ENV_FILE"
		if [ "${TRACE_TO_LANGFUSE:-}" = "true" ]; then
			# Account attribution: default LANGFUSE_USER_ID to the currently
			# active AMX account, unless the env file already pinned it.
			# Resolution order (design note P3, resolving P2 review item ②):
			#   1. the P3 active-profile pointer resolved above
			#      (AMX_ACTIVE_PROFILE_DIR) — reads the email straight out of
			#      that profile's own .claude.json, no subprocess involved;
			#   2. `tsamx status --json`'s active.email (pre-P3 behavior,
			#      kept as the fallback for as long as tsamx is what actually
			#      manages the pool);
			#   3. unset — LANGFUSE_USER_ID stays empty, same as today.
			# Step 1 is always skipped today (AMX_ACTIVE_PROFILE_DIR is only
			# ever set once something calls internal/seat.Switcher, and
			# nothing does yet), so this is a pure addition, not a behavior
			# change. Step 2 is bounded to 2s via timeout(1); if timeout(1) is
			# absent (some minimal images) it is skipped entirely rather than
			# run tsamx unbounded — pin LANGFUSE_USER_ID in the env file on
			# such hosts.
			if [ -z "${LANGFUSE_USER_ID:-}" ]; then
				if [ -n "${AMX_ACTIVE_PROFILE_DIR:-}" ] && command -v python3 >/dev/null 2>&1; then
					_lf_email=$(python3 -c 'import sys,json;d=json.load(open(sys.argv[1]));print((d.get("oauthAccount") or {}).get("emailAddress") or "")' "$AMX_ACTIVE_PROFILE_DIR/.claude.json" 2>/dev/null)
				fi
				if [ -z "${_lf_email:-}" ] \
					&& command -v timeout >/dev/null 2>&1 \
					&& command -v tsamx >/dev/null 2>&1; then
					_lf_email=$(timeout 2 tsamx status --json 2>/dev/null | python3 -c 'import sys,json;d=json.load(sys.stdin);print((d.get("active") or {}).get("email") or "")' 2>/dev/null)
				fi
				if [ -n "${_lf_email:-}" ]; then
					LANGFUSE_USER_ID="$_lf_email"
				fi
				unset _lf_email
			fi
			# Server attribution: default the tracing environment to this host.
			if [ -z "${LANGFUSE_TRACING_ENVIRONMENT:-}" ]; then
				LANGFUSE_TRACING_ENVIRONMENT="$(hostname 2>/dev/null || echo "")"
			fi
			# Export only under opt-in, so TRACE_TO_LANGFUSE!=true keeps the keys
			# out of the child env and the hook stays a no-op.
			export TRACE_TO_LANGFUSE
			export LANGFUSE_PUBLIC_KEY LANGFUSE_SECRET_KEY LANGFUSE_BASE_URL
			export LANGFUSE_USER_ID LANGFUSE_TRACING_ENVIRONMENT
			export CC_LANGFUSE_MAX_CHARS CC_LANGFUSE_DEBUG
		fi
		# 위험 명령어 훅(PreToolUse)의 통보 대상. Langfuse 추적(TRACE_TO_LANGFUSE)과는
		# 별개 기능이라 그 게이트 밖에서, env 파일에 값이 있을 때만 export한다.
		# 이 두 변수가 없으면 danger 훅은 자체적으로 즉시 no-op이다.
		if [ -n "${AMX_DANGER_INGEST_URL:-}" ]; then
			export AMX_DANGER_INGEST_URL
			[ -n "${AMX_DANGER_INGEST_TOKEN:-}" ] && export AMX_DANGER_INGEST_TOKEN
		fi
		# 세션 비용 구조 훅(Stop)의 통보 대상. danger 훅과 같은 규칙으로, env 파일에
		# 값이 있을 때만 export한다. 없으면 session_usage 훅은 즉시 no-op이다.
		if [ -n "${AMX_SESSION_INGEST_URL:-}" ]; then
			export AMX_SESSION_INGEST_URL
			[ -n "${AMX_SESSION_INGEST_TOKEN:-}" ] && export AMX_SESSION_INGEST_TOKEN
		fi
	fi
	set -e
fi
# -----------------------------------------------------------------------------

exec "$CLAUDE_BIN" "$@"
