# ── AMX 개발 스택 (deploy/fullstack-run.sh · agent-run.sh) ────
.amx-dev/
.amx-agent/

# ── 릴리스 산출물 (deploy/build-artifacts.sh) — 커밋하지 않음 ─
/dist/

# ── Python (tsamx, ams-server) ──────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node (ams-web) ──────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ── Go (ama-agent) ──────────────────────────────────────────
ama-agent/bin/
*.exe

# ── 시크릿 / 환경 ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# ── 훅 상태 파일 ─────────────────────────────────────────────
# 훅은 마지막 실패 1줄만 자기 옆 상태 파일에 남긴다(기본 경로). 저장소 안에서 훅을
# 실행하면 생기므로 추적 대상이 아니다. danger_hook 도 같은 규약이다.
deploy/langfuse/.session_usage_hook.state
deploy/langfuse/.danger_hook.state

# ── 로컬 도구 설정 ───────────────────────────────────────────
.claude/settings.local.json
.idea/
.vscode/

# ── OS 잡파일 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
