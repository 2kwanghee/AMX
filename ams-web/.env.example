# ams-web (BFF) server-process environment. NONE of these reach the browser.
# ---------------------------------------------------------------------------
# ams-server REST root, including the /api/v1 prefix.
AMX_API_BASE=http://localhost:8080/api/v1

# Administrator Bearer token for ams-server. Server-process only; the BFF
# attaches it to upstream calls. Never exposed to the browser.
AMX_ADMIN_TOKEN=change-me-at-least-16-chars

# HMAC secret used to sign the httpOnly session cookie (>= 16 chars).
AMX_SESSION_SECRET=change-me-session-secret

# Password the operator types on /login. Optional — falls back to AMX_ADMIN_TOKEN.
AMX_CONSOLE_PASSWORD=

# Session cookie lifetime in seconds (default 28800 = 8h).
AMX_SESSION_TTL_SECONDS=28800
